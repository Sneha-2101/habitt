# Database (Supabase Postgres)
DATABASE_URL= # Transaction pooled connection (port 6543 with ?pgbouncer=true) for serverless/Vercel
DIRECT_URL=   # Direct connection (port 5432) for Prisma migrations/push

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Supabase (SUPABASE_URL and NEXT_PUBLIC_SUPABASE_URL use the same Supabase project URL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co # Same value as SUPABASE_URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Email
RESEND_API_KEY=
