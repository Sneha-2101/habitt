# ==============================================================================
# Habitt Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# DATABASE_URL: Transaction pooler connection string (port 6543 on Supabase) used by Prisma Client.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL: Direct session connection string (port 5432) used for Prisma migrations.
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. NextAuth & Authentication
# ------------------------------------------------------------------------------
# Secret used by NextAuth to sign and encrypt JWTs/cookies (generate with: openssl rand -base64 32).
AUTH_SECRET="your-32-character-secret-key-goes-here"
NEXTAUTH_SECRET="your-32-character-secret-key-goes-here"
# Canonical URL of the application.
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. OTP Security & Rate Limiting
# ------------------------------------------------------------------------------
# Secret pepper used to HMAC-hash OTP verification codes before storing in DB (required in production).
OTP_PEPPER="your-secure-otp-pepper-secret-string"
# Maximum OTP sends allowed globally per UTC calendar day (default: 300).
OTP_DAILY_CAP="300"

# ------------------------------------------------------------------------------
# 4. Cloudflare Turnstile (Bot Protection)
# ------------------------------------------------------------------------------
# Cloudflare Turnstile Site Key (public). Development uses test key: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
# Cloudflare Turnstile Secret Key (server-only). Development uses test secret: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# ------------------------------------------------------------------------------
# 5. Upstash Redis (Distributed Rate Limiting)
# ------------------------------------------------------------------------------
# Upstash Redis REST URL and Token for sliding window rate limits.
# If unset in development, an in-memory sliding window fallback is used.
# In production, must be provided or requests throw RateLimitUnavailableError.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ------------------------------------------------------------------------------
# 6. Razorpay Payments
# ------------------------------------------------------------------------------
# Razorpay Key ID and Secret. Must begin with "rzp_test_" for testing/development.
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."
# Webhook secret configured in Razorpay dashboard for signature verification.
RAZORPAY_WEBHOOK_SECRET="..."

# ------------------------------------------------------------------------------
# 7. Supabase Client & Storage
# ------------------------------------------------------------------------------
# Supabase Project URL and API Keys.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGci..."
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="eyJhbGci..."

# ------------------------------------------------------------------------------
# 8. Email (Resend)
# ------------------------------------------------------------------------------
# API key for Resend email dispatch. Set to "disabled" during development/testing to mock sends.
RESEND_API_KEY="re_..."
# Verified sender email address (e.g., "Habitt <orders@yourdomain.com>").
RESEND_FROM_EMAIL="orders@yourdomain.com"

# ------------------------------------------------------------------------------
# 9. Meta WhatsApp Cloud API (Phone OTP & Notifications)
# ------------------------------------------------------------------------------
# Meta Cloud API permanent system user token. Dev servers use YOUR_META_WHATSAPP_TOKEN.
META_WHATSAPP_TOKEN=""
# WhatsApp Business Account phone number ID.
META_WHATSAPP_PHONE_NUMBER_ID=""
# Meta Graph API version (default: v20.0).
META_GRAPH_VERSION="v20.0"

# ------------------------------------------------------------------------------
# 10. Meta Pixel (Tracking & Analytics)
# ------------------------------------------------------------------------------
# Meta Pixel ID (e.g. 123456789012345). Widget stays inert if unset.
NEXT_PUBLIC_META_PIXEL_ID=""

# ------------------------------------------------------------------------------
# 11. Shiprocket (Logistics Integration)
# ------------------------------------------------------------------------------
# Shiprocket API credentials for manifest and pickup generation.
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
# Pickup location nickname in Shiprocket dashboard (defaults to SiteSettings value or Primary).
SHIPROCKET_PICKUP_LOCATION="Primary"

# ------------------------------------------------------------------------------
# 12. Cron Jobs & Automation
# ------------------------------------------------------------------------------
# Secret token passed in Authorization: Bearer <CRON_SECRET> header for cron endpoints.
CRON_SECRET="your-secure-cron-secret-token"

# ------------------------------------------------------------------------------
# 13. Database Seeding & Testing (Optional)
# ------------------------------------------------------------------------------
# Owner email and password for prisma/seed.ts
OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD="SecurePassword123!"
# Base URL for integration test suite (defaults to http://localhost:3000 if unset)
TEST_BASE_URL="http://localhost:3000"
