# Database (Supabase Postgres)
DATABASE_URL=
DIRECT_URL=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Supabase (SUPABASE_URL and NEXT_PUBLIC_SUPABASE_URL use the same Supabase project URL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co # Same value as SUPABASE_URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Shiprocket (Future Automated Logistics Integration)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary

# WhatsApp Support Widget
# NEXT_PUBLIC_WHATSAPP_NUMBER=
# Set this once your WhatsApp Business number is ready — the widget stays hidden until then.

# Meta WhatsApp Cloud API (Phone OTP Login)
META_WHATSAPP_TOKEN=            # Meta Permanent System User Token
META_WHATSAPP_PHONE_NUMBER_ID=  # Meta WhatsApp Business Phone Number ID
# Note: Leaving these blank enables [DEV MODE] console logging for OTP codes during testing.

# Meta Pixel (Ad Measurement & Tracking)
NEXT_PUBLIC_META_PIXEL_ID=       # Meta Pixel ID (e.g. 123456789012345). Widget stays inert if unset.