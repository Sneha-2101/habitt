// See Schema.md for the full rationale behind these models.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String
  position       Int           @default(0)
  sizes          String[]
  active         Boolean       @default(true)
  seoTitle       String?
  seoDescription String?
  introText      String?
  createdAt      DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  products     Product[]
  offerTargets OfferTarget[]
  gstRules     GstRule[]
}

model Product {
  id             String              @id @default(cuid())
  name           String
  slug           String              @unique
  description    String
  categoryId     String
  category       Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  price          Int // paise
  compareAtPrice Int?
  costPrice      Int?
  hsn            String?
  fabric         String?
  fit            String?
  care           String?
  sizeChartUrl   String?
  seoTitle       String?
  seoDescription String?
  publishAt      DateTime?
  status         ProductStatus       @default(DRAFT)
  images         ProductImage[]
  cartItems      CartItem[]
  variants       ProductVariant[]
  wishlistItems  WishlistItem[]
  reviews        Review[]
  collections    ProductCollection[]
  offerTargets   OfferTarget[]
  slugRedirects  ProductSlugRedirect[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model ProductSlugRedirect {
  id        String   @id @default(cuid())
  oldSlug   String   @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductImage {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String
  altText   String?
  position  Int     @default(0)
}

model ProductVariant {
  id        String     @id @default(cuid())
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  size      String
  color     String     @default("")
  colorHex  String?
  sku       String?    @unique
  stock     Int        @default(0)
  cartItems CartItem[]

  @@unique([productId, size, color])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Order {
  id                   String             @id @default(cuid())
  displayId            String             @unique
  user                 User               @relation(fields: [userId], references: [id])
  userId               String
  customerName         String
  customerPhone        String
  customerEmail        String?
  shippingAddress      Json
  items                OrderItem[]
  subtotal             Int
  shippingFee          Int                @default(0)
  codFee               Int                @default(0)
  total                Int
  feesRefunded         Boolean            @default(false)
  paymentStatus        PaymentStatus      @default(PENDING)
  fulfilmentStatus     FulfilmentStatus   @default(CREATED)
  paymentMethod        PaymentMethod      @default(RAZORPAY) // RAZORPAY or COD
  razorpayOrderId      String?            @unique
  razorpayPaymentId    String?
  paidAt               DateTime?
  razorpayRefundId     String?
  refundedAt           DateTime?
  refundAmount         Int?
  cancellationReason   String?
  courierName          String?
  awbNumber            String?
  shiprocketOrderId    String?
  shippedAt            DateTime?
  deliveredAt          DateTime?
  trackingUrl          String?
  statusEvents         OrderStatusEvent[]
  returnRequests       ReturnRequest[]
  notes                OrderNote[]
  discounts            OrderDiscount[]
  offerRedemptions     OfferRedemption[]
  invoice              Invoice?
  creditNotes          CreditNote[]
  refunds              Refund[]
  shipments            Shipment[]
  tickets              Ticket[]
  couponCode           String?
  discountAmount       Int?
  giftMessage          String?
  storeCreditApplied   Int                @default(0) // paise
  idempotencyKey       String?            @unique
  stockDeducted        Boolean            @default(false)
  abandonedEmailSentAt DateTime?
  loyaltyAccrual       LoyaltyAccrual?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([paymentStatus, fulfilmentStatus, createdAt])
}

enum PaymentMethod {
  RAZORPAY
  COD
  STORE_CREDIT
}

model SiteSettings {
  id                        String     @id @default("default")
  codEnabled                Boolean    @default(true)
  codOrderCap               Int        @default(500000) // in paise (e.g. 500000 = â‚¹5,000)
  shippingFee               Int        @default(9900) // in paise (e.g. 9900 = â‚¹99)
  freeShippingThreshold     Int        @default(299900) // in paise (e.g. 299900 = â‚¹2,999)
  codFeeEnabled             Boolean    @default(false)
  codFee                    Int        @default(0) // in paise (e.g. 5000 = â‚¹50)
  gstEnabled                Boolean    @default(false)
  gstRate                   Float      @default(0.0) // percentage (e.g. 18.0)
  gstin                     String?
  businessName              String     @default("habitt")
  businessTagline           String     @default("Minimalist Apparel Essentials")
  supportEmail              String     @default("support@habitt.in")
  orderSenderEmail          String     @default("orders@habitt.in")
  businessAddress           String?
  lowStockThreshold         Int        @default(3)
  welcomeCouponCode         String     @default("WELCOME10")
  welcomeCouponPercent      Int        @default(10)
  birthdayDiscountPercent   Int        @default(10)
  returnWindowDays          Int        @default(7)
  abandonedCartDelayHours   Int        @default(24)
  freeShippingOnPrepaid     Boolean    @default(true)
  codRequiresDeliveredOrder Boolean    @default(true)
  freeReturnShipping        Boolean    @default(true)
  refundProcessingHours     Int        @default(48)
  maxDeliveryDays           Int        @default(7)
  legalName                 String?
  businessPhone             String?
  businessState             String?
  businessPincode           String?
  whatsappSupportNumber     String?
  shiprocketPickupLocation  String     @default("Primary")
  gstFeeMode                GstFeeMode @default(COMPOSITE)
  gstFeeRate                Float      @default(18.0)
  invoicePrefix             String     @default("HB")
  grievanceOfficerName      String?
  grievanceOfficerEmail     String?
  grievanceOfficerPhone     String?
  grievanceOfficerAddress   String?
  businessAddressLine1      String?
  businessAddressLine2      String?
  businessCity              String?
  pickupAddressLine1        String?
  pickupAddressLine2        String?
  pickupCity                String?
  pickupPincode             String?
  pickupPhone               String?
  ordersEmail               String?
  replyToEmail              String?
  dispatchHandlingNote      String?
  instagramUrl              String?
  facebookUrl               String?
  promoCreditExpiryDays         Int        @default(180)
  walletMaxPercentOfOrder       Int        @default(100)
  maxAdminAdjustPaise           Int        @default(500000)
  loyaltyEnabled                Boolean    @default(false)
  loyaltyEnabledAt              DateTime?
  loyaltyModel                  String     @default("FLAT_PERCENT")
  loyaltyPercentBps             Int        @default(200)
  referralEnabled               Boolean    @default(false)
  referrerRewardPaise           Int        @default(0)
  refereeRewardPaise            Int        @default(0)
  referralMonthlyCapPerReferrer Int        @default(10)
  referralMinOrderPaise         Int        @default(0)
  referralValidityDays          Int        @default(90)
  seoIndexingEnabled            Boolean    @default(false)
  googleSiteVerification        String?
  ogDefaultImageUrl             String?
  updatedAt                     DateTime   @updatedAt
}

model HomeBanner {
  id         String    @id @default(cuid())
  imageUrl   String
  imageAlt   String
  heading    String
  subheading String?
  ctaLabel   String?
  ctaHref    String?
  sortOrder  Int       @default(0)
  isActive   Boolean   @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([isActive, sortOrder])
}

model SiteContent {
  key         String   @id
  title       String?
  body        String   @default("")
  isPublished Boolean  @default(true)
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
}

model OrderItem {
  id            String          @id @default(cuid())
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String
  productId     String
  variantId     String
  name          String
  size          String
  color         String          @default("")
  sku           String?
  unitPrice     Int
  qty           Int
  discountPaise Int             @default(0)
  isGift        Boolean         @default(false)
  discounts     OrderDiscount[]
  invoiceLines  InvoiceLine[]
  returnItems   ReturnItem[]
}

model OrderStatusEvent {
  id               String            @id @default(cuid())
  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId          String
  paymentStatus    PaymentStatus?
  fulfilmentStatus FulfilmentStatus?
  note             String?
  createdAt        DateTime          @default(now())
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  COD_PENDING
  COD_COLLECTED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum FulfilmentStatus {
  CREATED
  PLACED
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RTO
}

// Single table for everyone who can log in. Customers get role CUSTOMER at
// signup; STAFF/OWNER accounts are created manually (seed script or by an
// OWNER) â€” there's no public "become an admin" path. Login is required to
// buy, and the same /login page authenticates both â€” the header decides
// whether to show the Admin link based on `role`.
model User {
  id                      String                   @id @default(cuid())
  email                   String?                  @unique
  name                    String                   @default("")
  phone                   String?                  @unique
  dateOfBirth             DateTime?
  emailVerifiedAt         DateTime?
  phoneVerifiedAt         DateTime?
  cart                    Cart?
  /// FROZEN: legacy store credit balance (replaced by WalletLot/WalletEntry in M6a-2, dropped in M8).
  storeCreditBalance      Int                      @default(0) // paise
  role                    Role                     @default(CUSTOMER)
  status                  UserStatus               @default(ACTIVE)
  orders                  Order[]
  wishlistItems           WishlistItem[]
  addresses               Address[]
  reviews                 Review[]
  returnRequests          ReturnRequest[]
  storeCreditTransactions StoreCreditTransaction[]
  sessions                Session[]
  auditLogs               AuditLog[]
  offerRedemptions        OfferRedemption[]
  tickets                 Ticket[]                 @relation("UserTickets")
  assignedTickets         Ticket[]                 @relation("AssignedTickets")
  ticketMessages          TicketMessage[]          @relation("UserTicketMessages")
  siteContents            SiteContent[]
  walletLots              WalletLot[]
  walletEntries           WalletEntry[]
  loyaltyAccruals         LoyaltyAccrual[]
  referralCode            ReferralCode?
  referralsGiven          Referral[]               @relation("ReferrerRelation")
  referralReceived        Referral?                @relation("RefereeRelation")
  referralClaims          ReferralClaim[]
  createdAt               DateTime                 @default(now())
}

/// FROZEN: legacy store credit ledger (replaced by WalletLot/WalletEntry in M6a-2, dropped in M8).
model StoreCreditTransaction {
  id             String   @id @default(cuid())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  amount         Int // paise (+ for credit, - for debit)
  reason         String
  relatedOrderId String?
  createdAt      DateTime @default(now())
}

enum WalletLotKind {
  REFUND
  PROMO
  ADJUST
}

enum WalletEntryType {
  CREDIT
  DEBIT
  EXPIRE
  ADJUST
  RESTORE
}

model WalletLot {
  id             String        @id @default(cuid())
  user           User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId         String
  kind           WalletLotKind
  originalPaise  Int
  remainingPaise Int
  expiresAt      DateTime?
  sourceType     String?
  sourceId       String?
  note           String?
  entries            WalletEntry[]
  loyaltyAccruals    LoyaltyAccrual[]
  refereeReferrals   Referral[]       @relation("RefereeLotRelation")
  referrerReferrals  Referral[]       @relation("ReferrerLotRelation")
  createdAt          DateTime         @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([userId, kind, sourceType, sourceId])
  @@index([userId, remainingPaise, expiresAt])
  @@index([expiresAt, remainingPaise])
}

model WalletEntry {
  id                String          @id @default(cuid())
  user              User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId            String
  lot               WalletLot?      @relation(fields: [lotId], references: [id], onDelete: Restrict)
  lotId             String?
  type              WalletEntryType
  amountPaise       Int
  balanceAfterPaise Int
  orderId           String?
  actorId           String?
  reason            String
  idempotencyKey    String?         @unique
  createdAt         DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([lotId])
  @@index([orderId])
}

enum LoyaltyAccrualStatus {
  CREDITED
  SKIPPED
}

enum ReferralStatus {
  PENDING_VERIFICATION
  PENDING_FIRST_ORDER
  REWARDED
  REJECTED
  EXPIRED
}

model LoyaltyAccrual {
  id          String               @id @default(cuid())
  order       Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId     String               @unique
  user        User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId      String
  basePaise   Int
  earnedPaise Int
  status      LoyaltyAccrualStatus
  lot         WalletLot?           @relation(fields: [lotId], references: [id], onDelete: Restrict)
  lotId       String?
  createdAt   DateTime             @default(now())

  @@index([userId, createdAt])
}

model ReferralCode {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId    String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
}

model Referral {
  id              String         @id @default(cuid())
  referrer        User           @relation("ReferrerRelation", fields: [referrerId], references: [id], onDelete: Restrict)
  referrerId      String
  referee         User           @relation("RefereeRelation", fields: [refereeId], references: [id], onDelete: Restrict)
  refereeId       String         @unique
  codeUsed        String
  status          ReferralStatus
  rejectionReason String?
  refereeLot      WalletLot?     @relation("RefereeLotRelation", fields: [refereeLotId], references: [id], onDelete: Restrict)
  refereeLotId    String?
  referrerLot     WalletLot?     @relation("ReferrerLotRelation", fields: [referrerLotId], references: [id], onDelete: Restrict)
  referrerLotId   String?
  firstOrderId    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  expiresAt       DateTime

  @@index([referrerId, status])
  @@index([status, expiresAt])
}

model ReferralClaim {
  id              String   @id @default(cuid())
  referee         User     @relation(fields: [refereeId], references: [id], onDelete: Restrict)
  refereeId       String
  normalizedEmail String   @unique
  normalizedPhone String?  @unique
  createdAt       DateTime @default(now())
}

model OtpCode {
  id         String     @id @default(cuid())
  identifier String
  channel    OtpChannel
  code       String
  expiresAt  DateTime
  attempts   Int        @default(0)
  verified   Boolean    @default(false)
  createdAt  DateTime   @default(now())

  @@index([identifier, expiresAt])
}

enum OtpChannel {
  PHONE
  EMAIL
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum Role {
  CUSTOMER
  STAFF
  OWNER
}

model WishlistItem {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Address {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  fullName  String   @default("")
  phone     String   @default("")
  street    String
  line2     String?
  city      String
  state     String
  pincode   String
  label     String   @default("Home")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Note: partial unique index "Address_one_default_per_user" ("userId" WHERE "isDefault" = true) is defined in SQL migration.
}

model Cart {
  id        String     @id @default(cuid())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String     @unique
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String         @id @default(cuid())
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId String
  qty       Int
  createdAt DateTime       @default(now())

  @@unique([cartId, variantId])
}

model Review {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model StockNotification {
  id        String   @id @default(cuid())
  email     String
  productId String
  variantId String
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([email, variantId])
}

model ReturnRequest {
  id                String           @id @default(cuid())
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId           String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  reason            String
  status            ReturnStatus     @default(REQUESTED)
  adminNote         String?
  reasonCode        ReturnReasonCode @default(OTHER)
  customerNote      String?
  rejectedReason    String?
  approvedAt        DateTime?
  receivedAt        DateTime?
  refundInitiatedAt DateTime?
  items             ReturnItem[]
  refunds           Refund[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
  CANCELLED
}

enum ReturnReasonCode {
  WRONG_SIZE
  DEFECTIVE
  NOT_AS_DESCRIBED
  CHANGED_MIND
  OTHER
}

model ReturnItem {
  id          String        @id @default(cuid())
  return      ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  returnId    String
  orderItem   OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  orderItemId String
  qty         Int
  restock     Boolean?
  condition   String?
  createdAt   DateTime      @default(now())

  @@index([orderItemId])
}

enum RefundMethod {
  RAZORPAY
  STORE_CREDIT
  MANUAL
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

model Refund {
  id               String         @id @default(cuid())
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId          String
  returnRequest    ReturnRequest? @relation(fields: [returnId], references: [id], onDelete: SetNull)
  returnId         String?
  method           RefundMethod
  status           RefundStatus
  amountPaise      Int
  providerRefundId String?
  idempotencyKey   String         @unique
  initiatedAt      DateTime       @default(now())
  processedAt      DateTime?
  failureReason    String?
  createdAt        DateTime       @default(now())

  @@index([orderId])
  @@index([returnId])
}

model OrderNote {
  id         String   @id @default(cuid())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  authorName String
  body       String
  createdAt  DateTime @default(now())
}

model ProcessedWebhook {
  id         String   @id
  provider   String
  receivedAt DateTime @default(now())
}

enum StockReason {
  SALE
  COD_PLACED
  STORE_CREDIT_PLACED
  CANCEL
  RETURN
  RTO
  MANUAL_ADJUST
  OVERSOLD
}

model StockMovement {
  id        String      @id @default(cuid())
  variantId String
  delta     Int
  reason    StockReason
  refType   String?
  refId     String?
  actorId   String?
  createdAt DateTime    @default(now())

  @@index([variantId, createdAt])
}

model NewsletterSubscriber {
  id          String   @id @default(cuid())
  email       String   @unique
  consentedAt DateTime @default(now())
  source      String   @default("website")
  createdAt   DateTime @default(now())
}

model Session {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role              Role
  createdAt         DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())
  expiresAt         DateTime
  absoluteExpiresAt DateTime?
  revokedAt         DateTime?
  stepUpAt          DateTime?
  uaHash            String
  ipPrefix          String
  deviceLabel       String?

  @@index([userId, revokedAt])
  @@index([userId, uaHash])
}

model StaffAllowlist {
  id        String    @id @default(cuid())
  email     String    @unique
  role      Role
  active    Boolean   @default(true)
  addedById String?
  createdAt DateTime  @default(now())
  removedAt DateTime?
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  ipPrefix  String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model Collection {
  id           String              @id @default(cuid())
  slug         String              @unique
  name         String
  position     Int                 @default(0)
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  products     ProductCollection[]
  offerTargets OfferTarget[]
}

model ProductCollection {
  productId    String
  collectionId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

enum OfferKind {
  PERCENT_OFF
  FLAT_OFF
  TIER
  COMBO_ANY
  COMBO_SLOTS
  GIFT
}

enum OfferAudience {
  ALL
  FIRST_ORDER
  BIRTHDAY
}

model Offer {
  id                 String            @id @default(cuid())
  name               String
  kind               OfferKind
  code               String?           @unique
  active             Boolean           @default(false)
  startsAt           DateTime?
  endsAt             DateTime?
  minCartPaise       Int               @default(0)
  maxUsesTotal       Int?
  maxUsesPerCustomer Int?
  timesUsed          Int               @default(0)
  priority           Int               @default(100)
  audience           OfferAudience     @default(ALL)
  config             Json
  legacyCouponId     String?           @unique
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  targets            OfferTarget[]
  redemptions        OfferRedemption[]
  discounts          OrderDiscount[]
}

model OfferTarget {
  id           String      @id @default(cuid())
  offer        Offer       @relation(fields: [offerId], references: [id], onDelete: Cascade)
  offerId      String
  category     Category?   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId   String?
  product      Product?    @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId    String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionId String?

  @@unique([offerId, categoryId])
  @@unique([offerId, productId])
  @@unique([offerId, collectionId])
}

model OfferRedemption {
  id          String   @id @default(cuid())
  offer       Offer    @relation(fields: [offerId], references: [id], onDelete: Restrict)
  offerId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId      String?
  amountPaise Int
  createdAt   DateTime @default(now())

  @@unique([offerId, orderId])
}

enum OrderDiscountKind {
  PERCENT_OFF
  FLAT_OFF
  TIER
  COMBO_ANY
  COMBO_SLOTS
  GIFT_STOCK
  GIFT_TEXT
  COUPON_PERCENT
  COUPON_FLAT
}

model OrderDiscount {
  id          String            @id @default(cuid())
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  offer       Offer?            @relation(fields: [offerId], references: [id], onDelete: SetNull)
  offerId     String?
  label       String
  kind        OrderDiscountKind
  amountPaise Int               @default(0)
  orderItem   OrderItem?        @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  orderItemId String?
  createdAt   DateTime          @default(now())
}

enum GstFeeMode {
  COMPOSITE
  SEPARATE
}

enum InvoiceMode {
  TAX
  RECEIPT
}

enum InvoiceLineKind {
  GOODS
  SHIPPING
  COD
}

model GstRule {
  id           String    @id @default(cuid())
  name         String
  hsn          String?
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  minUnitPaise Int       @default(0)
  maxUnitPaise Int?
  ratePercent  Decimal   @db.Decimal(5, 2)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([active])
  @@index([hsn])
  @@index([categoryId])
}

model InvoiceCounter {
  fy         String   @id
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model Invoice {
  id            String        @id @default(cuid())
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  mode          InvoiceMode   @default(TAX)
  fy            String?
  number        String?       @unique
  prefix        String?
  sequence      Int?
  sellerGstin   String?
  sellerName    String
  sellerAddress Json
  sellerState   String?
  buyerName     String
  buyerGstin    String?
  buyerAddress  Json
  buyerState    String?
  placeOfSupply String?
  totalPaise    Int
  taxablePaise  Int
  cgstPaise     Int           @default(0)
  sgstPaise     Int           @default(0)
  igstPaise     Int           @default(0)
  isInterState  Boolean       @default(false)
  issuedAt      DateTime      @default(now())
  lines         InvoiceLine[]
  creditNotes   CreditNote[]

  @@index([mode])
  @@index([fy])
}

model InvoiceLine {
  id              String           @id @default(cuid())
  invoiceId       String
  invoice         Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderItemId     String?
  orderItem       OrderItem?       @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  kind            InvoiceLineKind  @default(GOODS)
  description     String
  hsn             String?
  qty             Int              @default(1)
  unitPaise       Int
  discountPaise   Int              @default(0)
  netPaise        Int
  ratePercent     Decimal          @db.Decimal(5, 2)
  taxablePaise    Int
  cgstPaise       Int              @default(0)
  sgstPaise       Int              @default(0)
  igstPaise       Int              @default(0)
  creditNoteLines CreditNoteLine[]

  @@index([invoiceId])
  @@index([orderItemId])
}

model CreditNote {
  id           String           @id @default(cuid())
  invoiceId    String
  invoice      Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  orderId      String
  order        Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fy           String
  number       String           @unique
  sequence     Int
  reason       String
  refundRef    String?
  totalPaise   Int
  taxablePaise Int
  cgstPaise    Int              @default(0)
  sgstPaise    Int              @default(0)
  igstPaise    Int              @default(0)
  issuedAt     DateTime         @default(now())
  lines        CreditNoteLine[]

  @@index([invoiceId])
  @@index([orderId])
  @@index([fy])
}

model CreditNoteLine {
  id            String          @id @default(cuid())
  creditNoteId  String
  creditNote    CreditNote      @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  invoiceLineId String?
  invoiceLine   InvoiceLine?    @relation(fields: [invoiceLineId], references: [id], onDelete: SetNull)
  kind          InvoiceLineKind @default(GOODS)
  description   String
  qty           Int             @default(1)
  ratePercent   Decimal         @db.Decimal(5, 2)
  taxablePaise  Int
  cgstPaise     Int             @default(0)
  sgstPaise     Int             @default(0)
  igstPaise     Int             @default(0)
  totalPaise    Int

  @@index([creditNoteId])
  @@index([invoiceLineId])
}

enum ShipmentProvider {
  MANUAL
  SHIPROCKET
}

enum ShipmentStatus {
  CREATED
  AWB_ASSIGNED
  PICKUP_SCHEDULED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RTO_INITIATED
  RTO_DELIVERED
  CANCELLED
  FAILED
}

model Shipment {
  id                 String           @id @default(cuid())
  order              Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId            String
  provider           ShipmentProvider
  status             ShipmentStatus   @default(CREATED)
  awb                String?
  courierName        String?
  trackingUrl        String?
  providerOrderId    String?
  providerShipmentId String?
  labelUrl           String?
  lastSyncedAt       DateTime?
  lastEventAt        DateTime?
  failureReason      String?
  events             ShipmentEvent[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([orderId])
}

model ShipmentEvent {
  id         String         @id @default(cuid())
  shipment   Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentId String
  status     ShipmentStatus
  rawStatus  String
  location   String?
  occurredAt DateTime
  source     String // 'WEBHOOK' | 'POLL' | 'MANUAL'
  dedupeKey  String         @unique
  createdAt  DateTime       @default(now())

  @@index([shipmentId])
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model EventOutbox {
  id            String       @id @default(cuid())
  type          String
  channel       String // 'EMAIL' | 'WHATSAPP'
  orderId       String?
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now())
  lastError     String?
  dedupeKey     String       @unique
  createdAt     DateTime     @default(now())
  sentAt        DateTime?

  @@index([status, nextAttemptAt])
}

model CronRun {
  id             String    @id @default(cuid())
  job            String
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  ok             Boolean?
  itemsProcessed Int?
  error          String?

  @@index([job, startedAt])
}

enum TicketCategory {
  ORDER
  PAYMENT
  RETURN_REFUND
  PRODUCT
  ACCOUNT
  GRIEVANCE
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketSource {
  ACCOUNT
  GUEST_FORM
  ADMIN
}

enum TicketAuthor {
  CUSTOMER
  STAFF
  SYSTEM
}

model Ticket {
  id               String          @id @default(cuid())
  number           String          @unique
  user             User?           @relation("UserTickets", fields: [userId], references: [id], onDelete: SetNull)
  userId           String?
  guestEmail       String?
  guestName        String?
  guestVerifiedAt  DateTime?
  order            Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId          String?
  orderRef         String?
  category         TicketCategory
  subject          String
  status           TicketStatus    @default(OPEN)
  source           TicketSource
  assignedTo       User?           @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId     String?
  accessTokenHash  String?
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?
  closedAt         DateTime?
  ackDueAt         DateTime
  resolveDueAt     DateTime
  slaAlertedAt     DateTime?
  ackAlertedAt     DateTime?
  resolveAlertedAt DateTime?
  messages         TicketMessage[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([status, resolveDueAt])
  @@index([userId])
  @@index([guestEmail])
  @@index([ackAlertedAt])
  @@index([resolveAlertedAt])
}

model TicketMessage {
  id           String       @id @default(cuid())
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId     String
  authorType   TicketAuthor
  authorUser   User?        @relation("UserTicketMessages", fields: [authorUserId], references: [id], onDelete: SetNull)
  authorUserId String?
  body         String
  internal     Boolean      @default(false)
  createdAt    DateTime     @default(now())

  @@index([ticketId, createdAt])
}
